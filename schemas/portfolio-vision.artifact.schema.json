{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://poesis.cloud/safe-agentic-framework/schemas/portfolio-vision.artifact.schema.json",
    "$ref": "https://poesis.cloud/safe-agentic-framework/artifact.schema.json",
    "title": "portfolio-vision artifact schema",
    "type": "object",
    "additionalProperties": true,
    "x-artifact": {
        "id": "portfolio-vision",
        "kind": "portfolio-vision",
        "template": "templates/layers/portfolio/actors/value-management-officier/artifacts/portfolio-vision.artifact-template.md",
        "pathPatterns": [
            "portfolio-vision.md"
        ],
        "renderOnly": false
    },
    "required": [
        "__path",
        "__kind",
        "__artifact_id",
        "__frontmatter_present"
    ],
    "properties": {
        "__path": {
            "description": "Workspace-relative path",
            "type": "string",
            "minLength": 1
        },
        "__kind": {
            "description": "Artifact-kind discriminator",
            "const": "portfolio-vision"
        },
        "__artifact_id": {
            "description": "Stable artifact id",
            "type": "string",
            "minLength": 1
        },
        "__frontmatter_present": {
            "description": "Harness assertion",
            "type": "boolean"
        },
        "__sections": {
            "type": "object",
            "additionalProperties": true
        },
        "__body": {
            "description": "Raw Markdown body",
            "type": "string"
        },
        "title": {
            "description": "Human-readable title",
            "type": "string",
            "minLength": 1
        },
        "sources": {
            "description": "Derivation provenance (narrowed subtype of the base contract's sources): refs to the upstream artifact(s) this portfolio-vision was built from. Allowed source kinds: strategic-themes.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "pattern": "(^|/)([a-z0-9-]+\\.)?(strategic-themes)\\.md$"
            }
        }
    }
}