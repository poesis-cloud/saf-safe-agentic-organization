{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://poesis.cloud/safe-agentic-framework/schemas/operability-review.artifact.schema.json",
  "title": "operability-review artifact schema",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "findings": {
      "description": "Operability findings raised by the review (each an object: id, severity, finding, recommendation).",
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "x-artifact": {
    "id": "operability-review",
    "kind": "operability-review",
    "template": "templates/layers/team/actors/operator/artifacts/operability-review.artifact-template.md",
    "pathPatterns": [
      "art/*/program-backlog/*/*.operability-review.md"
    ],
    "renderOnly": false
  },
  "required": [
    "__path",
    "__kind",
    "__artifact_id",
    "__frontmatter_present"
  ],
  "properties": {
    "__path": {
      "description": "Workspace-relative path of the artifact file, injected by the harness.",
      "type": "string",
      "minLength": 1
    },
    "__kind": {
      "description": "Artifact-kind discriminator injected by the harness; must equal x-artifact.kind.",
      "const": "operability-review"
    },
    "__artifact_id": {
      "description": "Stable artifact id injected by the harness.",
      "type": "string",
      "minLength": 1
    },
    "__frontmatter_present": {
      "description": "Harness assertion that YAML frontmatter was found and parsed.",
      "type": "boolean"
    },
    "__sections": {
      "description": "Artifact body sections keyed by their `## ` heading (advisory; additionalProperties permitted).",
      "type": "object",
      "properties": {
        "Subject under review": {
          "description": "Link / id of what is reviewed; restate the scope.",
          "type": "string"
        },
        "Findings": {
          "description": "Severity-graded findings table.",
          "type": "string"
        },
        "Verdict": {
          "description": "PASS | CONCERNS | FAIL.",
          "type": "string"
        },
        "Recommendations": {
          "description": "Remediation guidance for the owner.",
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "__body": {
      "description": "Raw Markdown body, injected by the harness.",
      "type": "string"
    },
    "id": {
      "description": "Stable artifact identifier (matches the filename stem).",
      "type": "string",
      "minLength": 1
    },
    "title": {
      "description": "Human-readable title.",
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "description": "The artifact id or path under review.",
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "description": "The reviewing agent handle (`@operator`).",
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "description": "Review verdict.",
      "enum": [
        "pass",
        "concerns",
        "fail"
      ]
    },
    "created": {
      "description": "Authoring date (YYYY-MM-DD).",
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "description": "Operability findings.",
      "$ref": "#/definitions/findings"
    },
    "open_items": {
      "description": "Open-item ledger.",
      "$ref": "https://poesis.cloud/safe-agentic-framework/schemas/framework-definitions.schema.json#/definitions/openItems"
    }
  },
  "allOf": [
    {
      "$ref": "https://poesis.cloud/safe-agentic-framework/artifact.schema.json"
    }
  ]
}
